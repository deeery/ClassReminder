<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 云同步与账号登录要访问 https://deeer.online。
         ⚠️ 这是硬性前提：缺这条权限时下面所有网络调用都会抛
         java.net.SocketException: Permission denied，
         而异常会被 catch 成「同步失败」—— 看起来像网络问题，实则是权限没声明。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 同步要读得到服务端状态（首屏显示上次同步时间），
         Android 9+ 默认禁止明文流量，域名是 https 所以不需要额外放开。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required to call startForeground() on Android 9+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for foregroundServiceType="dataSync" on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- For Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required by setFullScreenIntent() for the lock-screen popup (Android 14+ gates this
         for apps that are not calling/alarm apps; the user may need to enable it in settings) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Boot completed to optionally auto-start service -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 到点时唤醒屏幕：ColorOS 等 ROM 会拦全屏弹窗，只剩「通知 + 亮屏」这条可靠路径 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 应用内更新：下载完 APK 要交给系统安装器。
         安卓不允许应用静默安装，所以这条权限只是「允许发起安装请求」，
         用户仍然会在系统弹窗上点一次「安装」。
         Android 8+ 还要用户在设置里按应用授权（canRequestPackageInstalls()），
         没授权时我们引导过去，不硬闯。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassReminder">
        <!-- Main launcher activity -->
        <activity android:name="com.example.classreminder.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClassReminder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity that will be launched to show course info on the lock screen -->
        <activity
            android:name="com.example.classreminder.LockOverlayActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- Foreground service that runs continuously and triggers lock-screen UI -->
        <!-- android:foregroundServiceType is required on Android 14+ (targetSdk 34) -->
        <service
            android:name="com.example.classreminder.ClassReminderService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- Receiver to start service on boot if user enabled auto-start -->
        <receiver android:name="com.example.classreminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新下载下来的 APK 要通过 FileProvider 授出 uri 权限。
             不能直接传 file:// —— Android 7+ 会抛 FileUriExposedException。

             ⚠️ authority 必须走 `${applicationId}` 占位符，不能写死。
             debug 变体带 `applicationIdSuffix = ".test"`，与正式版**同机共存**；
             两边写同一个 authority 就会有两个已安装应用声明同一个 provider，
             PackageManager 解析到哪个是不确定的 —— 症状是「正式版更新时
             getUriForFile 抛 IllegalArgumentException」。代码侧对应
             `UpdateCenter.AUTHORITY = "${'$'}{ctx.packageName}.fileprovider"`。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
