<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to call startForeground() on Android 9+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for foregroundServiceType="dataSync" on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- For Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required by setFullScreenIntent() for the lock-screen popup (Android 14+ gates this
         for apps that are not calling/alarm apps; the user may need to enable it in settings) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Boot completed to optionally auto-start service -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 到点时唤醒屏幕：ColorOS 等 ROM 会拦全屏弹窗，只剩「通知 + 亮屏」这条可靠路径 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassReminder">
        <!-- Main launcher activity -->
        <activity android:name="com.example.classreminder.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClassReminder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity that will be launched to show course info on the lock screen -->
        <activity
            android:name="com.example.classreminder.LockOverlayActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- Foreground service that runs continuously and triggers lock-screen UI -->
        <!-- android:foregroundServiceType is required on Android 14+ (targetSdk 34) -->
        <service
            android:name="com.example.classreminder.ClassReminderService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- Receiver to start service on boot if user enabled auto-start -->
        <receiver android:name="com.example.classreminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
